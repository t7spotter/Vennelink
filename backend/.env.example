# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Leave `false` in production. Turn on only for local development.
DEBUG=false

# Hosts allowed to serve. Wildcards are risky; list your real domains.
# This must include every domain that reaches Django, e.g. per the reverse
# proxy setup in the README.
ALLOWED_HOSTS=links.example.com,app
# The "app" entry covers server-side fetches from the Next.js web container
# (next.config.ts rewrite + server components) — keep it in every deployment.

# Only needed for HTTPS deployments: scheme + host Django may treat as trusted
# for CSRF. Usually exactly your public URL.
CSRF_TRUSTED_ORIGINS=https://links.example.com

# The canonical public URL of this installation. Short links are built from
# it. Use the scheme and exact public domain.
SITE_URL=https://links.example.com

# Destinations that must never be shortenable (hosts and their subdomains).
# Leave empty to allow everything. Example:
# BLOCKED_DESTINATIONS=evil.example,bit.ly,banned.org

# --- Database (read as direct settings, not a URL) ----------------------
# Each value maps to a field of the Django DATABASES object in
# config/settings.py; no URL string is involved.
DB_NAME=shortener
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# CONN_MAX_AGE=0

# --- Docker Compose interpolation ---------------------------------------
# This file configures the backend stack. The frontend stack's DJANGO_BACKEND_URL
# and WEB_PORT live in ../frontend/.env.example.
# APP_PORT is published to 127.0.0.1 only: Django is the internal backend
# (admin, API, docs); reach it from the box itself, never from outside.
POSTGRES_DB=shortener
POSTGRES_PASSWORD=
APP_PORT=8000
# The app container inherits DB_* values via compose.yaml's environment
# block (DB_HOST is forced to the postgres service).

# --- TLS / headers ------------------------------------------------------
# Set true only once HTTPS actually works for the deployment.
SECURE_SSL_REDIRECT=false
# How long, in seconds, to tell browsers to remember HTTPS. Enable (e.g.
# 31536000) after HTTPS is confirmed working.
SECURE_HSTS_SECONDS=0
# Session/CSRF cookies: set true when the site is served over HTTPS only.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# The React client reads the CSRF token out of the cookie with JavaScript and
# sends it as X-CSRFToken, so this MUST stay false — under true the header is
# sent empty and Django 403s every mutation. Leave unset (defaults to false).
#CSRF_COOKIE_HTTPONLY=false

# Only set while operating a TRUSTED reverse proxy (own container or nginx
# front-end on the same host) which always sets X-Forwarded-Proto.
# Leave commented out otherwise.
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# --- Misc --------------------------------------------------------------
TIME_ZONE=UTC
# Non-UTC values follow the tz database, e.g. Europe/Berlin.

# Email backend used by password reset. Console backend prints to stdout for
# local testing; for real mail fill in the SMTP settings below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=vennelink@example.com

# Set false to make this install single-user (no signups).
# REGISTRATION_ENABLED=true

# Set false for an app-only install: "/" redirects to the dashboard (or
# login) and the marketing page disappears everywhere.
# LANDING_ENABLED=true

# Optional shared token required on every request to the /api/docs/ portal.
# Leave unset for public API documentation.
# APIWARDEN_TOKEN=

# Gunicorn worker count inside the container.
GUNICORN_WORKERS=2
