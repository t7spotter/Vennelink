# Frontend-only environment (see backend/.env.example for the Django side).

# where the Django backend lives, seen from this container:
#   same Docker network (started via backend/docker-compose.yaml):  http://app:8000
#   Django bound to the host (127.0.0.1 in backend/docker-compose.yaml):
#       docker run extra host — set http://host.docker.internal:8000
DJANGO_BACKEND_URL=http://app:8000

# public port of the React UI (proxy/CDN origin in production)
WEB_PORT=3000
