FROM reg1.sijaam.com/devops/base/node:22-slim AS css

WORKDIR /app

COPY package.json package-lock.json* ./

RUN npm ci --no-audit --no-fund

COPY static/ ./static/
COPY templates/ ./templates/
COPY accounts/ ./accounts/
COPY analytics/ ./analytics/
COPY links/ ./links/

RUN npx @tailwindcss/cli \
    -i static/css/src/input.css \
    -o static/css/app.css \
    --minify

FROM reg1.sijaam.com/devops/base/node:22-slim AS web

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

WORKDIR /app/frontend

ARG DJANGO_BACKEND_URL=http://app:8000

ENV DJANGO_BACKEND_URL=${DJANGO_BACKEND_URL}

COPY frontend/package.json frontend/package-lock.json ./

RUN npm ci --no-audit --no-fund

COPY frontend/ ./

RUN npm run build

EXPOSE 3000

CMD ["npx", "next", "start", "-H", "0.0.0.0", "-p", "3000"]

FROM reg1.sijaam.com/devops/base/python:3.12-slim AS backend

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./

RUN python -m pip install \
    --no-cache-dir \
    --retries 10 \
    --timeout 120 \
    -r requirements.txt

COPY . .

COPY --from=css \
    /app/static/css/app.css \
    static/css/app.css

EXPOSE 8000

CMD ["sh", "-ec", "\
python manage.py migrate --noinput && \
python manage.py collectstatic --noinput && \
mkdir -p api-docs/vennelink && \
python manage.py spectacular --file api-docs/vennelink/openapi.yaml && \
exec gunicorn --bind 0.0.0.0:8000 --workers ${GUNICORN_WORKERS:-2} --chdir /app config.wsgi:application"]